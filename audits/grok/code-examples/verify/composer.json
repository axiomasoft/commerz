{
  "require": {
    "php": "^8.4",
    "brick/math": "^0.13|^0.14",
    "laravel/framework": "^13.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1"
  },
  "autoload": {
    "classmap": [
      "../"
    ],
    "exclude-from-classmap": [
      "../migrations/2026_",
      "../verify/"
    ]
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "stan": "phpstan analyse -c phpstan.neon --no-progress",
    "smoke": "php -d zend.assertions=1 smoke.php",
    "db": "php dbsmoke.php"
  }
}