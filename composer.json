{
    "name": "axiomasoft/commerz-monorepo",
    "description": "Commerz monorepo: embeddable Laravel commerce package family.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true,
                "versions": {
                    "axiomasoft/commerz-b2b": "0.1.x-dev",
                    "axiomasoft/commerz-catalog": "0.1.x-dev",
                    "axiomasoft/commerz": "0.1.x-dev",
                    "axiomasoft/commerz-full": "0.1.x-dev",
                    "axiomasoft/commerz-inventory": "0.1.x-dev",
                    "axiomasoft/commerz-pricing": "0.1.x-dev",
                    "axiomasoft/commerz-promotions": "0.1.x-dev",
                    "axiomasoft/commerz-sales": "0.1.x-dev",
                    "axiomasoft/commerz-shipping": "0.1.x-dev",
                    "axiomasoft/commerz-stored-value": "0.1.x-dev",
                    "axiomasoft/commerz-subscriptions": "0.1.x-dev",
                    "axiomasoft/commerz-testkit": "0.1.x-dev"
                }
            }
        },
        {
            "type": "path",
            "url": "../packman/packages/*",
            "options": {
                "symlink": true,
                "versions": {
                    "axiomasoft/packman": "0.1.1",
                    "axiomasoft/packman-schema": "0.1.1",
                    "axiomasoft/packman-plugins": "0.1.1",
                    "axiomasoft/packman-panels": "0.1.1",
                    "axiomasoft/packman-filament": "0.1.1",
                    "axiomasoft/packman-testkit": "0.1.1",
                    "axiomasoft/packman-devtools": "0.1.1"
                }
            }
        }
    ],
    "require": {
        "php": ">=8.4 <8.7",
        "axiomasoft/commerz": "^0.1@dev",
        "axiomasoft/commerz-b2b": "^0.1@dev",
        "axiomasoft/commerz-catalog": "^0.1@dev",
        "axiomasoft/commerz-full": "^0.1@dev",
        "axiomasoft/commerz-inventory": "^0.1@dev",
        "axiomasoft/commerz-pricing": "^0.1@dev",
        "axiomasoft/commerz-promotions": "^0.1@dev",
        "axiomasoft/commerz-sales": "^0.1@dev",
        "axiomasoft/commerz-shipping": "^0.1@dev",
        "axiomasoft/commerz-stored-value": "^0.1@dev",
        "axiomasoft/commerz-subscriptions": "^0.1@dev",
        "axiomasoft/packman": "^0.1.1",
        "axiomasoft/packman-panels": "^0.1.1",
        "axiomasoft/packman-plugins": "^0.1.1",
        "axiomasoft/packman-schema": "^0.1.1"
    },
    "require-dev": {
        "axiomasoft/commerz-testkit": "^0.1@dev",
        "axiomasoft/packman-devtools": "^0.1.1",
        "axiomasoft/packman-testkit": "^0.1.1",
        "driftingly/rector-laravel": "^2.7",
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.32",
        "nikic/php-parser": "^5.4",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.2",
        "pestphp/pest-plugin-phpstan": "^5.3.1",
        "phpstan/phpstan": "^2.2.16 <2.3.6",
        "phpstan/phpstan-strict-rules": "^2.0.12",
        "rector/rector": "^2.6"
    },
    "autoload-dev": {
        "psr-4": {
            "Commerz\\Tests\\": "packages/core/tests/",
            "Commerz\\B2b\\Tests\\": "packages/b2b/tests/",
            "Commerz\\Catalog\\Tests\\": "packages/catalog/tests/",
            "Commerz\\Inventory\\Tests\\": "packages/inventory/tests/",
            "Commerz\\Pricing\\Tests\\": "packages/pricing/tests/",
            "Commerz\\Promotions\\Tests\\": "packages/promotions/tests/",
            "Commerz\\Shipping\\Tests\\": "packages/shipping/tests/",
            "Commerz\\Sales\\Tests\\": "packages/sales/tests/",
            "Commerz\\StoredValue\\Tests\\": "packages/stored-value/tests/",
            "Commerz\\Subscriptions\\Tests\\": "packages/subscriptions/tests/",
            "Commerz\\Arch\\": "tests/Arch/Support/",
            "Commerz\\EndToEnd\\": "tests/EndToEnd/"
        }
    },
    "scripts": {
        "lint": "vendor/bin/pint",
        "lint:check": "vendor/bin/pint --test",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=2G --no-progress",
        "refactor": "vendor/bin/rector process",
        "refactor:check": "vendor/bin/rector process --dry-run",
        "test": "vendor/bin/pest --exclude-group=pg",
        "test:pg": "vendor/bin/pest --group=pg",
        "test:arch": "vendor/bin/pest --testsuite=Arch",
        "gate": "@php vendor/bin/packman gate",
        "php-api": "@php vendor/bin/packman php-api --check",
        "error-codes": "@php vendor/bin/packman error-codes --check",
        "config-schema": "@php vendor/bin/packman config-schema --check",
        "ai:sync": "@php vendor/bin/packman ai:sync --dry-run",
        "api:manifest": "@php scripts/generate-api-manifest.php",
        "api:check": "@php scripts/generate-api-manifest.php --check",
        "docs:reference": "@php scripts/generate-api-reference.php"
    },
    "config": {
        "sort-packages": true,
        "process-timeout": 0,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "audit": {
            "abandoned": "report"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
