{
    "name": "axiomasoft/commerz-b2b",
    "description": "Commerz B2B: business unit hierarchies, associates, approval flows, payment terms, credit limits, and 3-stage negotiated quotes.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4 <8.7",
        "axiomasoft/commerz": "^0.1",
        "axiomasoft/packman": "^0.1.1",
        "axiomasoft/packman-panels": "^0.1.1",
        "axiomasoft/packman-plugins": "^0.1.1",
        "axiomasoft/packman-schema": "^0.1.1",
        "brick/math": "^0.14.2 || ^0.15 || ^0.16 || ^0.17",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Commerz\\B2b\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Commerz\\B2b\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Commerz\\B2b\\B2bServiceProvider"
            ]
        },
        "packman": {
            "schema-version": 1,
            "package-type": "addon",
            "stability": "stable",
            "error-prefix": "b2b",
            "owns": [
                "Approvals",
                "BusinessUnits",
                "Configuration",
                "Diagnostics",
                "Errors",
                "Facades",
                "Internal",
                "Laravel",
                "Panels",
                "PaymentTerms",
                "Plugins",
                "Quotes",
                "Schema"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
