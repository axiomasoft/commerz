{
    "name": "axiomasoft/commerz-catalog",
    "description": "Commerz catalog: products, variants, attributes, categories, listings.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4 <8.6",
        "axiomasoft/commerz": "^0.1",
        "axiomasoft/packman": "^0.1",
        "axiomasoft/packman-panels": "^0.1",
        "axiomasoft/packman-plugins": "^0.1",
        "axiomasoft/packman-schema": "^0.1",
        "brick/math": "^0.14.2 || ^0.15 || ^0.16 || ^0.17",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Commerz\\Catalog\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Commerz\\Catalog\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Commerz\\Catalog\\CatalogServiceProvider"
            ]
        },
        "packman": {
            "schema-version": 1,
            "package-type": "addon",
            "stability": "stable",
            "error-prefix": "catalog",
            "owns": [
                "Attributes",
                "Categories",
                "Common",
                "Configuration",
                "Diagnostics",
                "Errors",
                "Facades",
                "Internal",
                "Laravel",
                "Listings",
                "Options",
                "Panels",
                "Plugins",
                "Products",
                "ProductTypes",
                "Schema",
                "Variants"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
