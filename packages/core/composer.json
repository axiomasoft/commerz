{
    "name": "axiomasoft/commerz",
    "description": "Embeddable commerce domain core: money, context, ports, plugins, stores, outbox.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4 <8.6",
        "axiomasoft/packman": "^0.1.1",
        "axiomasoft/packman-panels": "^0.1.1",
        "axiomasoft/packman-plugins": "^0.1.1",
        "axiomasoft/packman-schema": "^0.1.1",
        "brick/math": "^0.14.2 || ^0.15 || ^0.16 || ^0.17",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Commerz\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Commerz\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Commerz\\CommerzServiceProvider"
            ]
        },
        "packman": {
            "schema-version": 1,
            "package-type": "domain",
            "stability": "stable",
            "error-prefix": "commerz",
            "owns": [
                "Configuration",
                "Context",
                "CustomFields",
                "Diagnostics",
                "Errors",
                "Facades",
                "Identity",
                "Internal",
                "Laravel",
                "Measures",
                "Metadata",
                "Money",
                "Operations",
                "Outbox",
                "Pagination",
                "Panels",
                "Plugins",
                "Ports",
                "Quotes",
                "Schema",
                "Stores",
                "Time"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
