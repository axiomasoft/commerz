                        }
                    },
                    "additionalProperties": false
                },
                "plugins": {
                    "type": [
                        "array",
                        "object"
                    ]
                },
                "schema_scope": {
                    "type": [
                        "string",
                        "integer",
                        "number",
                        "boolean",
                        "array",
                        "object",
                        "null"
                    ]
                },
                "stock": {
                    "type": [
                        "string",
                        "integer",
                        "number",
                        "boolean",
                        "array",
                        "object",
                        "null"
                    ]
                },
                "table_prefix": {
                    "type": "string",
                    "default": "cmz_"
                }
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": false
}
