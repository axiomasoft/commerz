{
    "name": "axiomasoft/commerz-full",
    "description": "Commerz metapackage: core and all domain packages.",
    "type": "metapackage",
    "license": "MIT",
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4 <8.7",
        "axiomasoft/commerz": "^0.1",
        "axiomasoft/commerz-b2b": "^0.1",
        "axiomasoft/commerz-catalog": "^0.1",
        "axiomasoft/commerz-inventory": "^0.1",
        "axiomasoft/commerz-pricing": "^0.1",
        "axiomasoft/commerz-promotions": "^0.1",
        "axiomasoft/commerz-sales": "^0.1",
        "axiomasoft/commerz-shipping": "^0.1",
        "axiomasoft/commerz-stored-value": "^0.1",
        "axiomasoft/commerz-subscriptions": "^0.1"
    },
    "extra": {
        "packman": {
            "schema-version": 1,
            "package-type": "metapackage",
            "stability": "stable"
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
