{
    "name": "axiomasoft/commerz-pricing",
    "description": "Commerz pricing: price lists, resolution and tax.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "axiomasoft/commerz": "^0.1@dev",
        "illuminate/database": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Commerz\\Pricing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Commerz\\Pricing\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Commerz\\Pricing\\PricingServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
