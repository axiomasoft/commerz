{
    "name": "axiomasoft/commerz-promotions",
    "description": "Commerz promotions: discounts, coupons, usage limits.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4 <8.7",
        "axiomasoft/commerz": "^0.1",
        "axiomasoft/packman": "^0.1.1",
        "axiomasoft/packman-panels": "^0.1.1",
        "axiomasoft/packman-plugins": "^0.1.1",
        "axiomasoft/packman-schema": "^0.1.1",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Commerz\\Promotions\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Commerz\\Promotions\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Commerz\\Promotions\\PromotionsServiceProvider"
            ]
        },
        "packman": {
            "schema-version": 1,
            "package-type": "addon",
            "stability": "stable",
            "error-prefix": "promotions",
            "owns": [
                "Campaigns",
                "Common",
                "Configuration",
                "Coupons",
                "Definitions",
                "Diagnostics",
                "Errors",
                "Evaluation",
                "Facades",
                "Internal",
                "Laravel",
                "Panels",
                "Plugins",
                "Rules",
                "Schema",
                "Usage"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
