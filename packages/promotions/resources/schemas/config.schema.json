{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "axiomasoft/commerz-promotions configuration",
    "type": "object",
    "properties": {
        "commerz-promotions": {
            "type": "object",
            "properties": {
                "coupons": {
                    "type": "object",
                    "properties": {
                        "alphabet": {
                            "type": "string",
                            "default": "23456789ABCDEFGHJKMNPQRSTUVWXYZ"
                        },
                        "max_generate": {
                            "type": "integer",
                            "default": 50000
                        }
                    },
                    "additionalProperties": false
                },
                "max_codes": {
                    "type": "integer",
                    "default": 5
                },
                "restore_on": {
                    "type": "array"
                },
                "rounding": {
                    "type": "string",
                    "default": "half_up"
                }
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": false
}
