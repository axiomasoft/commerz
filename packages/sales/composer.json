{
    "name": "axiomasoft/commerz-sales",
    "description": "Commerz sales: cart, checkout, orders, payments, fulfillment, returns.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4 <8.7",
        "axiomasoft/commerz": "^0.1",
        "axiomasoft/packman": "^0.1.1",
        "axiomasoft/packman-panels": "^0.1.1",
        "axiomasoft/packman-plugins": "^0.1.1",
        "axiomasoft/packman-schema": "^0.1.1",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Commerz\\Sales\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Commerz\\Sales\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Commerz\\Sales\\SalesServiceProvider"
            ]
        },
        "packman": {
            "schema-version": 1,
            "package-type": "addon",
            "stability": "stable",
            "error-prefix": "sales",
            "owns": [
                "Carts",
                "Checkout",
                "Common",
                "Configuration",
                "Diagnostics",
                "Errors",
                "Exchanges",
                "Facades",
                "Fulfillments",
                "Gateways",
                "Internal",
                "Laravel",
                "Numbering",
                "OrderChanges",
                "Orders",
                "Panels",
                "Payments",
                "Plugins",
                "Refunds",
                "Returns",
                "Schema"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
