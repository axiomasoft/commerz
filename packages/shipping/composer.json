{
    "name": "axiomasoft/commerz-shipping",
    "description": "Commerz shipping: zones, methods, rates, delivery options.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4 <8.6",
        "axiomasoft/commerz": "^0.1",
        "axiomasoft/packman": "^0.1.1",
        "axiomasoft/packman-panels": "^0.1.1",
        "axiomasoft/packman-plugins": "^0.1.1",
        "axiomasoft/packman-schema": "^0.1.1",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Commerz\\Shipping\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Commerz\\Shipping\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Commerz\\Shipping\\ShippingServiceProvider"
            ]
        },
        "packman": {
            "schema-version": 1,
            "package-type": "addon",
            "stability": "stable",
            "error-prefix": "shipping",
            "owns": [
                "Bookings",
                "Carriers",
                "Common",
                "Configuration",
                "Diagnostics",
                "Errors",
                "Facades",
                "Internal",
                "Laravel",
                "Methods",
                "Options",
                "Panels",
                "Plugins",
                "Rates",
                "Schema",
                "Zones"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
