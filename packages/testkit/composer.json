{
    "name": "axiomasoft/commerz-testkit",
    "description": "Commerz testkit: package test case, port fakes and contract tests.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4 <8.7",
        "axiomasoft/commerz": "^0.1",
        "axiomasoft/packman": "^0.1.1",
        "axiomasoft/packman-plugins": "^0.1.1",
        "axiomasoft/packman-testkit": "^0.1.1",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0",
        "orchestra/testbench": "^11.3"
    },
    "suggest": {
        "axiomasoft/commerz-catalog": "Required for AssertsSearchEngineCompliance and FakeSearchEngine.",
        "axiomasoft/commerz-pricing": "Required for AssertsTaxCalculatorCompliance.",
        "axiomasoft/commerz-sales": "Required for AssertsPaymentProviderCompliance.",
        "axiomasoft/commerz-shipping": "Required for AssertsCarrierCompliance."
    },
    "autoload": {
        "psr-4": {
            "Commerz\\Testkit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Commerz\\Testkit\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "extra": {
        "packman": {
            "schema-version": 1,
            "package-type": "dev",
            "stability": "stable",
            "owns": [
                "Contracts",
                "Fakes"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
