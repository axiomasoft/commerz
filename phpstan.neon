includes:
    - vendor/axiomasoft/packman-devtools/config/phpstan-base.neon
    - vendor/larastan/larastan/extension.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/pestphp/pest-plugin-phpstan/extension.neon

parameters:
    tmpDir: build/phpstan
    universalObjectCratesClasses:
        - Illuminate\Http\Request
        - Illuminate\Support\Optional
        - Pest\Support\HigherOrderTapProxy
        - Pest\Expectation
        - PHPUnit\Framework\TestCase
    scanFiles:
        - vendor/pestphp/pest/src/Functions.php
    excludePaths:
        - tests/Arch/Fixtures
    paths:
        - packages/core/src
        - packages/core/tests
        - packages/catalog/src
        - packages/catalog/tests
        - packages/inventory/src
        - packages/inventory/tests
        - packages/pricing/src
        - packages/pricing/tests
        - packages/promotions/src
        - packages/promotions/tests
        - packages/shipping/src
        - packages/shipping/tests
        - packages/sales/src
        - packages/sales/tests
        - packages/stored-value/src
        - packages/stored-value/tests
        - packages/subscriptions/src
        - packages/subscriptions/tests
        - packages/b2b/src
        - packages/b2b/tests
        - packages/testkit/src
        - packages/testkit/tests
        - tests
        - scripts
