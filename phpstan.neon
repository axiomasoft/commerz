includes:
    - vendor/axiomasoft/packman-devtools/config/phpstan-base.neon
    - vendor/larastan/larastan/extension.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
    tmpDir: build/phpstan
    paths:
        - packages/core/src
        - packages/catalog/src
        - packages/inventory/src
        - packages/pricing/src
        - packages/promotions/src
        - packages/shipping/src
        - packages/sales/src
        - packages/testkit/src
        - packages/testkit/tests
    ignoreErrors:
        # Temporary Slice-A ignores for unmigrated feature subpackages under strict phpstan-base rules (cleaned up in Slice B).
        -
            identifier: missingType.callable
            path: packages/catalog/src/Products/Internal/FilterCompiler.php
        -
            identifier: argument.type
            path: packages/sales/src/Internal/Console/ExpireOrdersCommand.php
